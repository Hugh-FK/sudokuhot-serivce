{
  "name": "sudokuhot-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sudokuhot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sudokuhot-db --remote",
    "db:backup:remote": "bash scripts/d1-backup-to-r2.sh",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250605.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "wrangler": "^4.99.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.15",
    "@elysiajs/swagger": "^1.3.1",
    "@sinclair/typebox": "^0.34.49",
    "drizzle-orm": "^0.44.2",
    "elysia": "^1.4.28",
    "openapi-types": "^12.1.3"
  }
}
