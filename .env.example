# 环境变量示例文件
# 复制此文件为 .dev.vars 并填入实际值

# ================================
# 应用基础配置
# ================================
APP_ENV=development
APP_NAME=CouponPies API
APP_VERSION=1.0.0

# ================================
# 数据库配置
# ================================
# DATABASE_URL=

# ================================
# 认证配置
# ================================
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# API_SECRET_KEY=

# ================================
# CORS 配置
# ================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ================================
# 第三方服务
# ================================
# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# SendGrid
# SENDGRID_API_KEY=

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# ================================
# 其他配置
# ================================
# REDIS_URL=
# LOG_LEVEL=info
