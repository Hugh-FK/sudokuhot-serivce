# 环境变量示例文件
# 复制此文件为 .dev.vars 并填入实际值

# ================================
# 应用基础配置
# ================================
APP_ENV=development
APP_NAME=Sudoku Hot API
APP_VERSION=1.0.0

# ================================
# 数据库配置
# ================================
# DATABASE_URL=

# ================================
# 认证配置（Google OAuth 回调在 API 域名）
# ================================
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
API_SECRET_KEY=change-me-in-dev

# 本地 wrangler dev 默认端口 8787；须与 Google 控制台「已获授权的重定向 URI」一致
API_PUBLIC_URL=http://127.0.0.1:8787
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/v1/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 登录成功后跳回前端（由 API /v1/auth/callback 带上 ?token= 重定向到此页的 /auth/callback）
FRONTEND_URL=http://localhost:4321

# ================================
# CORS 配置
# ================================
# 生产示例（须与前端实际 Origin 一致，含协议与是否 www）
# ALLOWED_ORIGINS=https://sudokuhot.com,https://www.sudokuhot.com,http://sudokuhot.com,http://www.sudokuhot.com
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:8787

# ================================
# 第三方服务
# ================================
# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# SendGrid
# SENDGRID_API_KEY=

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# ================================
# 其他配置
# ================================
# REDIS_URL=
# LOG_LEVEL=info
